# ============================================================
# 秘密 / 个人信息 —— 绝不入库
# ============================================================
# 家里 WiFi 的 NM 连接文件含 WPA PSK 明文
device/etc/NetworkManager/system-connections/*.nmconnection
# 但 usb0 这条是静态配置、无凭据，允许入库
!device/etc/NetworkManager/system-connections/z17s-usb0.nmconnection

# SSH 私钥 / 密码本
*.pem
*.key
id_*
*password*
*secret*

# ============================================================
# Windows 上无法索引的符号链接
# ============================================================
# 设备上这个单元文件是指向 /dev/null 的软链（= "Wi-Fi watchdog 已禁用" 的标记）。
# 它在 Windows 上会变成 ReparsePoint，git / 删除工具都处理不了，所以排除。
# 部署脚本 install-on-device.sh 里有对应的等价处理（显式 disable 该单元）。
device/etc/systemd/system/z17s-wifi-watchdog.service

# ============================================================
# 临时与下载
# ============================================================
_dl/
_tmp/
*.tgz
*.tar
*.tar.gz
*.zip

# ============================================================
# 大体积备份产物（系统镜像、分区 dump）
# ============================================================
backup/
*.img
*.img.gz
*.dd.gz
*.raw

# 日志
*.log
