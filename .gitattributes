# 统一换行符策略
# - Linux 侧文件（脚本/配置）强制 LF，否则 systemd / udev / shell 会出问题
# - Windows 侧脚本用 CRLF，.cmd 批处理对 LF 敏感

* text=auto eol=lf

*.sh          text eol=lf
*.conf        text eol=lf
*.rules       text eol=lf
*.service     text eol=lf
*.timer       text eol=lf
*.nmconnection text eol=lf
*.md          text eol=lf

*.ps1         text eol=crlf
*.cmd         text eol=crlf

*.gz          binary
*.img         binary
*.tgz         binary
